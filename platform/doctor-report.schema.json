                            "P1a",
                            "P1b",
                            "P2",
                            "P3",
                            "P4",
                            "later"
                          ]
                        },
                        "tier": {
                          "enum": [
                            "tier1",
                            "tier2",
                            "tier3"
                          ]
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind"
                      ],
                      "properties": {
                        "kind": {
                          "const": "not_listed"
                        }
                      }
                    }
                  ]
