    "redacted": {
      "type": "boolean"
    },
    "schema_version": {
      "const": 1
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "tool_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "\\S",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff]"
      }
    }
