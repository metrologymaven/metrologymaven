{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metrologymaven.io/schemas/kernel-manifest.schema.json",
  "title": "Metrology Maven kernel manifest, schema version 1 (spec node KRN.MAN.MANI.SCHEMA)",
  "$comment": "Must agree with crates/fid-kci/src/manifest.rs; fixtures/man/manifest/labels.txt is checked against both. Rules JSON Schema cannot state, enforced by the Rust reader only: no duplicate keys, input at most 4 MiB, algorithms strictly sorted by ID (module, feature, method, then numeric version), artifacts strictly sorted by (role, target), and core_digest equal to SHA-256 over the RFC 8785 canonical JSON of core. Patterns end in $(?!\\n) so that validators whose $ also matches before a final newline (Python re) agree with ECMA-262.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifacts", "core", "core_digest"],
  "properties": {
    "artifacts": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "sha256", "target"],
        "properties": {
          "role": { "$ref": "#/$defs/token" },
          "sha256": { "$ref": "#/$defs/digest" },
          "target": { "$ref": "#/$defs/target" }
        }
      }
    },
    "core": { "$ref": "#/$defs/core" },
    "core_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "$comment": "fid_types::Digest wire form: sha256: then 64 lowercase hex digits.",
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$(?!\\n)"
    },
    "token": {
      "$comment": "name, numeric_profile and artifact role.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]*$(?!\\n)"
    },
    "target": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$(?!\\n)"
    },
    "semver": {
      "$comment": "SemVer 2.0.0 MAJOR.MINOR.PATCH with an optional pre-release and no build metadata.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$(?!\\n)"
    },
    "algorithm_id": {
      "$comment": "<module>.<feature>.<method>@<major>.<minor>.<patch> (KRN.MAN.CARD); each version part is a u32 without leading zeros.",
      "type": "string",
      "maxLength": 128,
      "not": { "$comment": "Module kernel is reserved for the kernel's own queries (KRN.MAN.MANI.GEN).", "pattern": "^kernel[.]" },
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*@(0|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])\\.(0|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])\\.(0|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])$(?!\\n)"
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithms",
        "facade_selftest_digest",
        "lockfile_digest",
        "name",
        "native_gate",
        "numeric_profile",
        "reference_results_digest",
        "reference_suite_digest",
        "replay_runtime",
        "schema_version",
        "semver",
        "solver_limits_digest",
        "source_tree_digest",
        "toolchain_digest"
      ],
      "properties": {
        "algorithms": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["card_digest", "id", "impl_digest"],
            "properties": {
              "card_digest": { "$ref": "#/$defs/digest" },
              "id": { "$ref": "#/$defs/algorithm_id" },
              "impl_digest": { "$ref": "#/$defs/digest" }
            }
          }
        },
        "facade_selftest_digest": { "$ref": "#/$defs/digest" },
        "lockfile_digest": { "$ref": "#/$defs/digest" },
        "name": { "$ref": "#/$defs/token" },
        "native_gate": { "enum": ["measured-only", "gating"] },
        "numeric_profile": { "$ref": "#/$defs/token" },
        "reference_results_digest": { "$ref": "#/$defs/digest" },
        "reference_suite_digest": { "$ref": "#/$defs/digest" },
        "replay_runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["config_digest", "version"],
          "properties": {
            "config_digest": { "$ref": "#/$defs/digest" },
            "version": { "$ref": "#/$defs/semver" }
          }
        },
        "schema_version": { "const": "1" },
        "semver": { "$ref": "#/$defs/semver" },
        "solver_limits_digest": { "$ref": "#/$defs/digest" },
        "source_tree_digest": { "$ref": "#/$defs/digest" },
        "toolchain_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
