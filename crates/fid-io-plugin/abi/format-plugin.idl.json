{
  "exports": [
    {
      "doc": "Return the plugin descriptor declaring formats, signatures, options schemas and requested caps.",
      "name": "descriptor",
      "params": [],
      "result": "plugin-descriptor"
    },
    {
      "doc": "Read untrusted bytes from a bounded stream with validated options and return neutral records.",
      "name": "read",
      "params": [
        {
          "name": "req",
          "type": "read-request"
        }
      ],
      "result": "result<list<plugin-record>, plugin-error>"
    },
    {
      "doc": "Write neutral entities with validated options and return output bytes.",
      "name": "write",
      "params": [
        {
          "name": "req",
          "type": "write-request"
        }
      ],
      "result": "result<list<u8>, plugin-error>"
    }
  ],
  "format": "format-plugin-idl@1",
  "framing": {
    "encoding": "u32-le-length-prefixed",
    "max_frame_bytes": 16777216
  },
  "imports": [],
