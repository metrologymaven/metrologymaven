{"$id":"https://metrologymaven.io/schema/job-status.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"command":{"pattern":"^[a-z0-9]([a-z0-9_.]*[a-z0-9])?@[0-9]{1,5}$","type":"string"},"ended_at":{"description":"Wall-clock time (UTC, RFC 3339, milliseconds) when the job reached a terminal state; null until then.","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$","type":["string","null"]},"error":{"enum":["timeout","cancelled","handler_failed","not_found","queue_full",null]},"id":{"pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$","type":"string"},"progress":{"maximum":1,"minimum":0,"type":"number","x-quantity":"dimensionless"},"stage":{"maxLength":128,"type":"string"},"started_at":{"description":"Wall-clock time (UTC, RFC 3339, milliseconds) when the job started running; null while it is queued or if it never ran.","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$","type":["string","null"]},"state":{"enum":["queued","running","succeeded","failed","cancelled"]},"submitted_at":{"description":"Wall-clock time (UTC, RFC 3339, milliseconds) when the job was submitted. For display only: job lists are ordered by the scheduler's monotonic submission time, then job ID, never by this field.","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$","type":"string"}},"required":["command","ended_at","error","id","progress","stage","started_at","state","submitted_at"],"title":"Metrology Maven job status","type":"object"}
