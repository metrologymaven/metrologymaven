{"$id":"https://metrologymaven.io/schema/job-status.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"command":{"pattern":"^[a-z0-9]([a-z0-9_.]*[a-z0-9])?@[0-9]{1,5}$","type":"string"},"ended_at":{"minimum":0,"type":["number","null"],"x-quantity":"time","x-unit":"s"},"error":{"enum":["timeout","cancelled","handler_failed","not_found","queue_full",null]},"id":{"pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$","type":"string"},"progress":{"maximum":1,"minimum":0,"type":"number"},"stage":{"maxLength":128,"type":"string"},"started_at":{"minimum":0,"type":["number","null"],"x-quantity":"time","x-unit":"s"},"state":{"enum":["queued","running","succeeded","failed","cancelled"]},"submitted_at":{"minimum":0,"type":"number","x-quantity":"time","x-unit":"s"}},"required":["command","ended_at","error","id","progress","stage","started_at","state","submitted_at"],"title":"Metrology Maven job status","type":"object"}
