{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metrologymaven.io/schema/eval-task-v1.schema.json",
  "title": "Metrology Maven evaluation task (AGENT.EVAL.FORMAT, task.json)",
  "description": "Structural rules only. The parser (crate fid-eval-suite) also enforces: unique licence files, the 64 MiB / depth 64 limits, duplicate-key rejection and the start-state digest check.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source_job", "golden_digest", "start_state", "prompt", "profile", "budget", "roots", "tier", "apps", "workflows", "licences"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "source_job": {"$ref": "#/$defs/text"},
    "golden_digest": {"$ref": "#/$defs/digest"},
    "start_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {"path": {"$ref": "#/$defs/relpath"}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "prompt": {"type": "string", "minLength": 1},
    "profile": {"$ref": "#/$defs/text"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_s", "tool_calls"],
      "properties": {
        "wall_s": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "tool_calls": {"type": "integer", "minimum": 1, "maximum": 4294967295}
      }
    },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write"],
      "properties": {
        "read": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/relpath"}},
        "write": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/relpath"}}
      }
    },
    "tier": {"enum": ["single_command", "multi_step", "full_job"]},
    "apps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["inspect", "probe", "network", "report"]}
    },
    "workflows": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "licences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "spdx"],
        "properties": {
          "file": {"$ref": "#/$defs/relpath"},
          "spdx": {"type": "string", "maxLength": 64, "pattern": "^(project-authored|[A-Za-z0-9][A-Za-z0-9.+-]*)$"}
        }
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "relpath": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^(?!\\.\\.?(/|$))(?!.*/\\.\\.?(/|$))[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
    }
  }
}
