{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metrologymaven.io/schema/persona-set-v1.schema.json",
  "title": "persona-set@1",
  "description": "Persona definitions file (spec node FLOW.PERSONA.PERS). Cross-file rules (exactly the nine IDs, primary_app in the app list, auditor on the verifier) are checked by `cargo xtask personas-check`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "personas"],
  "properties": {
    "format": { "const": "persona-set@1" },
    "personas": {
      "type": "array",
      "items": { "$ref": "#/$defs/persona" }
    }
  },
  "$defs": {
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "goals", "environment", "primary_app", "entry_phase", "governance_profile"],
      "properties": {
        "id": { "type": "string", "pattern": "^JOB\\.PER\\.0[1-9]$" },
        "role": { "type": "string", "minLength": 1, "maxLength": 120 },
        "goals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "environment": { "enum": ["shop_floor", "office", "lab", "field"] },
        "primary_app": { "type": "string", "minLength": 1 },
        "entry_phase": { "enum": ["P0", "P1a", "P1b", "P2", "P3", "P4", "later"] },
        "governance_profile": { "enum": ["lean", "regulated", "assistive_only"] }
      }
    }
  }
}
