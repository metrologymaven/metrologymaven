{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metrologymaven.io/schema/journey-map-v1.json",
  "title": "journey-map@1",
  "description": "Journey map (spec node FLOW.PERSONA.SCHEMA). Rules this schema cannot state are checked by the validator in crate fid-accept, module journey: step numbers are 1, 2, 3, ... in list order (MAP-STEP-ORDER); a numeric handoff names the next step's n (MAP-STEP-ORDER); the subject of a persona map is in personas; persona IDs named in handoff or decision text are in personas; a human_only step is not attributed to an agent (MAP-AGENT-HUMANONLY); the file is at most 1 MiB and nested at most 32 deep (MAP-SIZE).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "map_id", "subject", "kind", "revision", "app", "phase", "personas", "steps"],
  "properties": {
    "format": { "const": "journey-map@1" },
    "map_id": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$" },
    "subject": { "type": "string", "pattern": "^JOB\\.[A-Z]{1,8}\\.[0-9]{2}$" },
    "kind": { "enum": ["persona", "job", "setup"] },
    "revision": { "type": "integer", "minimum": 1 },
    "app": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$" },
    "phase": { "$ref": "#/$defs/phase" },
    "personas": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^JOB\\.PER\\.[0-9]{2}$" }
    },
    "exercised_by": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^JOB\\.ACC\\.[0-9]{2}$" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "persona" } }, "required": ["kind"] },
      "then": {
        "required": ["exercised_by"],
        "properties": { "subject": { "pattern": "^JOB\\.PER\\.[0-9]{2}$" } }
      },
      "else": { "not": { "required": ["exercised_by"] } }
    },
    {
      "if": { "properties": { "kind": { "const": "job" } }, "required": ["kind"] },
      "then": { "properties": { "subject": { "pattern": "^JOB\\.(ACC|USE)\\.[0-9]{2}$" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "setup" } }, "required": ["kind"] },
      "then": { "properties": { "subject": { "pattern": "^JOB\\.USE\\.[0-9]{2}$" } } }
    }
  ],
  "$defs": {
    "phase": { "enum": ["P0", "P1a", "P1b", "P2", "P3", "P4", "later"] },
    "text": { "description": "1 to 256 characters without control characters; the validator's limit is 256 UTF-8 bytes, which is stricter for non-ASCII text.", "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$" },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "actor", "owner", "handoff", "human_only"],
      "oneOf": [{ "required": ["command"] }, { "required": ["screen"] }],
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "actor": { "enum": ["human", "operator", "admin", "agent", "system"] },
        "command": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9_.]*[a-z0-9])?@[0-9]{1,5}$" },
        "screen": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$" },
        "owner": { "type": "string", "maxLength": 128, "pattern": "^[A-Z][A-Z0-9]*(\\.[A-Z][A-Z0-9]*)*$" },
        "handoff": { "oneOf": [{ "$ref": "#/$defs/text" }, { "type": "integer", "minimum": 1 }] },
        "decision": { "$ref": "#/$defs/text" },
        "human_only": { "type": "boolean" },
        "phase": { "$ref": "#/$defs/phase" }
      }
    }
  }
}
