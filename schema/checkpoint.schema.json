{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metrologymaven.io/schema/checkpoint.schema.json",
  "title": "Metrology Maven journal checkpoint (schema version 1, format linear-v1, spec node CORE.JRN.CHAIN.CKPT)",
  "description": "A checkpoint names a stream, a sequence, the hash of the entry at that sequence (the head) and the number of entries up to it, plus an optional Access Ledger head. Its canonical bytes are its RFC 8785 form and its digest is SHA-256 over those bytes; TRUST signs the canonical bytes. `format` selects the layout: version 1 of this schema defines only `linear-v1`, and a verifier refuses any other value. In `linear-v1` the count equals the sequence. Sequences and counts are decimal strings. `time` is UTC with whole seconds. Every pattern also refuses any newline, because `$` in ECMA-262 and Python regexes can match before a trailing newline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "stream",
    "seq",
    "head",
    "count",
    "reason",
    "time"
  ],
  "properties": {
    "format": {
      "const": "linear-v1"
    },
    "stream": {
      "$ref": "#/$defs/stream"
    },
    "seq": {
      "$ref": "#/$defs/seq"
    },
    "head": {
      "$ref": "#/$defs/digest"
    },
    "count": {
      "$ref": "#/$defs/seq"
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "head"
      ],
      "properties": {
        "seq": {
          "$ref": "#/$defs/seq"
        },
        "head": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "reason": {
      "enum": [
        "signature",
        "export",
        "close"
      ]
    },
    "time": {
      "$ref": "#/$defs/time"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "not": {
        "pattern": "\n"
      }
    },
    "seq": {
      "type": "string",
      "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$",
      "not": {
        "pattern": "\n"
      }
    },
    "stream": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "not": {
        "pattern": "\n"
      }
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "not": {
        "pattern": "\n"
      }
    }
  }
}
