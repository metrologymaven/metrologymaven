-            return Err(SparseFormatError::IncompatibleDimension);
-        }
-        if I.iter().any(|&i| i >= m) {
-            return Err(SparseFormatError::BadRowval);
-        }
-        if J.iter().any(|&j| j >= n) {
-            return Err(SparseFormatError::BadColptr);
-        }
