-        if d.is_empty() {
-            T::max_value()
-        } else {
-            svec_to_mat(workΔ, d);
-            workΔ.lrscale(Λisqrt, Λisqrt);
-            engine.eigvals(workΔ).expect("Eigval error");
-            engine.λ.minimum()
-        }
-    };
-
-    if γ < T::zero() {
-        T::min(-γ.recip(), αmax)
-    } else {
-        αmax
-    }
-}
