-        // initial problem data
-        let init_dims = (A.ncols(), A.nrows());
-
-        let mut chordal_info = Self {
-            init_dims,
-            init_cones: vec![],
-            spatterns: vec![],
-            H: None,         // no H to start
-            cone_maps: None, // no cone_maps to start
-        };
