-pub(crate) fn backtrack_search<T>(
-    dq: &[T],
-    q: &[T],
-    α_init: T,
-    α_min: T,
-    step: T,
-    is_in_cone_fcn: impl Fn(&[T]) -> bool,
-    work: &mut [T],
