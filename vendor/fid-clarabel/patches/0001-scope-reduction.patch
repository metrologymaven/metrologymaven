-fn parent_block_indices(parent_clique: &[usize], i: usize, j: usize) -> usize {
-    let ir = parent_clique.partition_point(|&x| x < i); //first index >= i
-    let jr = parent_clique.partition_point(|&x| x < j); //first index >= j
