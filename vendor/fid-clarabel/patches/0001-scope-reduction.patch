-impl<T> ChordalInfo<T>
-where
-    T: FloatT,
-{
-    pub(crate) fn new(
-        A: &CscMatrix<T>,
-        b: &[T],
-        cones: &[SupportedConeT<T>],
-        settings: &CoreSettings<T>,
