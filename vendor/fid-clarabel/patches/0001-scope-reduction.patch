-fn find_aggregate_sparsity_mask<T: FloatT>(A: &CscMatrix<T>, b: &[T]) -> Vec<bool> {
-    let mut active = vec![false; b.len()];
-
-    for &r in A.rowval.iter() {
-        active[r] = true;
-    }
-
-    for (i, &bi) in b.iter().enumerate() {
-        if bi != T::zero() {
