-    const fn get_dimension() -> usize {
-        let mut n = 0;
-        while triangular_number(n) < S {
-            n += 1;
-        }
-        assert!(triangular_number(n) == S);
-        n
-    }
-    pub(crate) const fn dim(&self) -> usize {
