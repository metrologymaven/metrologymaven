#!/usr/bin/env python3
"""Static key-bytes scan for keystore crates (spec node TRUST.SIGN.KEYSTORE.TRAIT, REQ-004).

Default mode scans every Rust source file under `crates/fid-keystore*/src/` (or `--root <path>`)
and fails non-zero if any non-test code:
  1. derives `Debug`, `Display` or `Serialize` on a private-key type, on a type that holds a
     private-key-typed field (directly or transitively) or key bytes, or on `KeyHandle` /
     `ReleasedSigner`; `#[cfg_attr(..., derive(...))]` counts the same as `#[derive(...)]`;
  2. implements `Serialize` or `Display`, or a content-bearing `Debug`, for any of those types
     (a `Debug` body must say `redacted` and must not touch key/byte fields);
  3. lets a private-key value reach a sink: file writers (`fs::write`, `write(`, `write_all(`,
     `write!`, ...), log macros (bare or path-qualified `error!`/`warn!`/`info!`/`debug!`/
     `trace!`, `println!`, `dbg!`, ...), panic/assert messages, `format!` and error
     constructors (`Err(`, `*Error::Variant(`), journal writers and package writers. A
     private-key value is any reference to `seed`, `scalar`, `secret` (and similar names),
     any `.material` / `.seed` / `.scalar` field, any field that holds a private-key type or
     key bytes, any variable typed as a private-key type, and any `let` binding copied from one
     of these (one-level taint, iterated to a fixpoint). Inline format arguments
     (`"{seed:?}"`) count;
  4. calls a private-key export API (`NCryptExportKey`, `SecKeyCopyExternalRepresentation`,
     `to_pkcs8_*`, `to_sec1_*`);
  5. declares a `pub fn` (or `pub trait` method) returning a private-key type or a raw byte
     array (`[u8; N]`), a `pub fn` on a key type returning key bytes, or a `pub` field holding
     key bytes or a private-key type.

`--uv-release-issue [--workspace <repo>]` scans every Rust file of the workspace and fails if
`UvRelease::issue` is reached (directly, via `<UvRelease>::issue`, or through a `use ... as` /
`type` alias of `UvRelease`) outside crate `fid-uv` and outside fid-keystore's own tests
(`crates/fid-keystore/tests/` and `#[cfg(test)]` items in `crates/fid-keystore/src/`).
Maintainer decision on PR #444: `TRUST.SIGN.UV` is the only producer of UV releases.

Known limitations (recorded in the leaf's Open questions): taint does not follow values through
function calls, struct fields of non-key types, closures or other crates; `#[cfg(test)]` is the
only test gate recognised.

Stdlib only; runs on Linux, macOS and Windows.
"""

import os
import re
import sys

# --------------------------------------------------------------------------- type vocabulary

PRIVATE_TYPE_NAME_RE = re.compile(
    r"(?i)^(?:(?:private|secret|signing)[a-z0-9_]*key[a-z0-9_]*|key[a-z0-9_]*(?:material|seed|bytes|secret|scalar)[a-z0-9_]*|secretscalar|rawkey|softwaresigner)$"
)

KNOWN_PRIVATE_TYPES = {
    "PrivateKeyMaterial",
    "PrivateKey",
    "SecretKey",
    "SigningKey",
    "SoftwareSigner",
    "KeyMaterial",
    "SecretScalar",
    "KeySeed",
}

ALWAYS_REDACTED_TYPES = {"KeyHandle", "ReleasedSigner"}

FORBIDDEN_DERIVES = {"Debug", "Display", "Serialize"}

# Field accesses a Debug body of a key type must never make.
SECRET_FIELD_ACCESS_RE = re.compile(
    r"\.\s*(?:bytes|key|seed|scalar|secret|raw|material|to_bytes|as_bytes|as_slice|0)\b"
)

REDACTION_RE = re.compile(r"(?i)redacted")

# Byte containers that can carry raw key bytes.
BYTE_CONTAINER_RE = re.compile(
    r"\[\s*u8\s*;|&\s*(?:'\w+\s+)?(?:mut\s+)?\[\s*u8\s*\]|\bVec\s*<\s*u8\s*>|\bBox\s*<\s*\[\s*u8\s*\]\s*>|\bZeroizing\s*<|\bSecret(?:Box|Vec|Slice)?\s*<|\bBytes(?:Mut)?\b"
)
RAW_ARRAY_RE = re.compile(r"\[\s*u8\s*;|\bZeroizing\s*<|\bSecret(?:Box|Vec|Slice)?\s*<")

# Field names that mark a byte field as key bytes in a type not otherwise known as a key type.
SECRET_FIELD_NAME_RE = re.compile(r"(?i)^(?!.*pub)(?:.*(?:seed|scalar|secret|priv|material|key).*|sk|d)$")

# Identifiers and field accesses treated as private-key values wherever they appear.
SECRET_IDENT_RE = re.compile(
    r"\b(?:seeds?|scalars?|secrets?|private_key|secret_key|key_bytes|secret_bytes|raw_private|pkcs8_private|raw_key|sk_bytes)\b"
)
SECRET_FIELD_RE = re.compile(
    r"\.\s*(?:material|seed|scalar|secret|private_key|secret_key|raw_key|key_bytes)\b(?!\s*\()"
)
# Accessors that only yield public data; a key value followed by one of these is not a leak.
PUBLIC_ACCESS = r"(?!\s*\.\s*(?:public_key|public|fingerprint|algorithm|alg|name|label|created|hardware)\b)"

# --------------------------------------------------------------------------- sinks

SINKS = [
    ("file writer", re.compile(r"\b(?:write|write_all|write_vectored|write_fmt|write_sidecar)\s*(?=\()")),
    ("file writer", re.compile(r"\b(?:write|writeln)!\s*(?=[\(\[\{])")),
    ("file writer", re.compile(r"\bFile::create\s*(?=\()|\bOpenOptions\b")),
    ("log writer", re.compile(r"\b(?:e?println|e?print|dbg)!\s*(?=[\(\[\{])")),
    ("log writer", re.compile(r"\b(?:error|warn|info|debug|trace|log|event)!\s*(?=[\(\[\{])")),
    (
        "panic message",
        re.compile(
            r"\b(?:panic|unreachable|todo|unimplemented|assert|assert_eq|assert_ne|debug_assert|debug_assert_eq|debug_assert_ne)!\s*(?=[\(\[\{])"
        ),
    ),
    ("error or format string", re.compile(r"\b(?:format|format_args|anyhow|bail|ensure)!\s*(?=[\(\[\{])")),
    ("error or format string", re.compile(r"\bErr\s*(?=\()|\b[A-Z]\w*Error\s*::\s*[A-Z]\w*\s*(?=\()")),
    ("journal writer", re.compile(r"\b(?:append_event|JournalWriter|EventWriter|journal_write)\b")),
    ("package writer", re.compile(r"\b(?:PackageWriter|ZipWriter|write_entry|fid_pkg::[a-zA-Z0-9_:]*write)\b")),
]

EXPORT_API_DENYLIST = [
    ("NCryptExportKey", re.compile(r"\bNCryptExportKey\b")),
    ("SecKeyCopyExternalRepresentation", re.compile(r"\bSecKeyCopyExternalRepresentation\b")),
    ("to_pkcs8_pem", re.compile(r"\bto_pkcs8_pem\b")),
    ("to_pkcs8_der", re.compile(r"\bto_pkcs8_der\b")),
    ("to_sec1_der", re.compile(r"\bto_sec1_der\b")),
    ("to_sec1_pem", re.compile(r"\bto_sec1_pem\b")),
]

# --------------------------------------------------------------------------- lexing

RAW_STR_START_RE = re.compile(r'b?r(#*)"')
PLACEHOLDER_RE = re.compile(r"\{([A-Za-z_][A-Za-z0-9_]*)")
IDENT_CHARS = set("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_")


def _mask_literal(content: str) -> str:
    """Blanks a string literal's content, keeping only inline format-argument identifiers."""
    out = ["\n" if c == "\n" else " " for c in content]
    i = 0
    while i < len(content):
        if content.startswith("{{", i):
            i += 2
            continue
        m = PLACEHOLDER_RE.match(content, i)
        if m:
            for k in range(m.start(1), m.end(1)):
                out[k] = content[k]
            i = m.end()
            continue
        i += 1
    return "".join(out)


def lex(source: str):
    """Returns (stripped, masked), both the same length as `source`.

    stripped: comments replaced by spaces (newlines kept).
    masked:   additionally, string/char literal contents blanked except inline format args.
    """
    stripped = []
    masked = []
    i = 0
    n = len(source)

    def emit(text_s, text_m):
        stripped.append(text_s)
        masked.append(text_m)

    while i < n:
        ch = source[i]
        nxt = source[i + 1] if i + 1 < n else ""
        if ch == "/" and nxt == "/":
            j = source.find("\n", i)
            j = n if j == -1 else j
            blank = " " * (j - i)
            emit(blank, blank)
            i = j
            continue
        if ch == "/" and nxt == "*":
            depth = 0
            j = i
            while j < n:
                if source.startswith("/*", j):
                    depth += 1
                    j += 2
                    continue
                if source.startswith("*/", j):
                    depth -= 1
                    j += 2
                    if depth == 0:
                        break
                    continue
                j += 1
            seg = "".join("\n" if c == "\n" else " " for c in source[i:j])
            emit(seg, seg)
            i = j
            continue
        if ch in "rb" and (i == 0 or source[i - 1] not in IDENT_CHARS):
            m = RAW_STR_START_RE.match(source, i)
            if m:
                close = '"' + m.group(1)
                end = source.find(close, m.end())
                end = n if end == -1 else end
                content = source[m.end() : end]
                stop = min(n, end + len(close))
                emit(source[i:stop], source[i : m.end()] + _mask_literal(content) + source[end:stop])
                i = stop
                continue
        if ch == '"':
            j = i + 1
            while j < n:
                if source[j] == "\\":
                    j += 2
                    continue
                if source[j] == '"':
                    break
                j += 1
            end = min(j, n)
            content = source[i + 1 : end]
            stop = min(n, end + 1)
            emit(source[i:stop], '"' + _mask_literal(content) + source[end:stop])
            i = stop
            continue
        if ch == "'" and i + 2 < n and (source[i + 1] == "\\" or source[i + 2] == "'"):
            j = i + 1
            if source[j] == "\\":
                j += 2
            while j < n and source[j] != "'":
                j += 1
            stop = min(n, j + 1)
            seg = source[i:stop]
            inner = "".join("\n" if c == "\n" else " " for c in seg[1:-1])
            emit(seg, (seg[0] + inner + seg[-1]) if len(seg) >= 2 else seg)
            i = stop
            continue
        emit(ch, ch)
        i += 1
    return "".join(stripped), "".join(masked)


def matching_close(text: str, open_idx: int) -> int:
    """Index of the delimiter closing the one at `open_idx` (or len(text) - 1)."""
    pairs = {"(": ")", "[": "]", "{": "}"}
    opener = text[open_idx]
    closer = pairs[opener]
    depth = 0
    for i in range(open_idx, len(text)):
        if text[i] == opener:
            depth += 1
        elif text[i] == closer:
            depth -= 1
            if depth == 0:
                return i
    return len(text) - 1


CFG_TEST_RE = re.compile(r"#\s*\[\s*cfg\s*\(\s*test\s*\)\s*\]")


def test_spans(masked: str):
    """Spans of `#[cfg(test)]` items (attribute through the item's closing brace or `;`)."""
    spans = []
    pos = 0
    while True:
        m = CFG_TEST_RE.search(masked, pos)
        if not m:
            break
        brace = masked.find("{", m.end())
        semi = masked.find(";", m.end())
        if semi != -1 and (brace == -1 or semi < brace):
            end = semi + 1
        elif brace != -1:
            end = matching_close(masked, brace) + 1
        else:
            break
        spans.append((m.start(), end))
        pos = end
    return spans


def blank_spans(text: str, spans) -> str:
    chars = list(text)
    for start, end in spans:
        for k in range(start, min(end, len(chars))):
            if chars[k] != "\n":
                chars[k] = " "
    return "".join(chars)


def load(path: str):
    with open(path, "r", encoding="utf-8") as f:
        raw = f.read()
    stripped, masked = lex(raw)
    spans = test_spans(masked)
    return blank_spans(stripped, spans), blank_spans(masked, spans)


def line_of(text: str, offset: int) -> int:
    return text.count("\n", 0, offset) + 1


# --------------------------------------------------------------------------- declarations

DECL_RE = re.compile(
    r"(?P<attrs>(?:#\s*\[[^\]]*\]\s*)*)(?P<vis>\bpub\b(?:\s*\([^)]*\))?\s+)?\b(?P<kind>struct|enum|union)\s+(?P<name>[A-Za-z_]\w*)"
)
ATTR_RE = re.compile(r"#\s*\[[^\]]*\]")
DERIVE_RE = re.compile(r"\bderive\s*\(([^()]*)\)")
NAMED_FIELD_RE = re.compile(r"^\s*(?P<vis>pub(?:\s*\([^)]*\))?\s+)?(?P<name>[A-Za-z_]\w*)\s*:\s*(?P<ty>.+)$", re.DOTALL)
TUPLE_FIELD_RE = re.compile(r"^\s*(?P<vis>pub(?:\s*\([^)]*\))?\s+)?(?P<ty>.+)$", re.DOTALL)


def split_top_level(body: str):
    """Splits on commas outside (), [], {}, <> (treating `->` as not closing an angle)."""
    parts = []
    depth = 0
    cur = []
    i = 0
    while i < len(body):
        c = body[i]
        if c == "-" and i + 1 < len(body) and body[i + 1] == ">":
            cur.append("->")
            i += 2
            continue
        if c in "([{<":
            depth += 1
        elif c in ")]}>":
            depth -= 1
        if c == "," and depth == 0:
            parts.append("".join(cur))
            cur = []
        else:
            cur.append(c)
        i += 1
    if "".join(cur).strip():
        parts.append("".join(cur))
    return [p for p in parts if p.strip()]


def find_body_open(text: str, start: int):
    """First `{`, `(` or `;` after `start` outside angle brackets; returns (index, char)."""
    depth = 0
    i = start
    while i < len(text):
        c = text[i]
        if c == "-" and i + 1 < len(text) and text[i + 1] == ">":
            i += 2
            continue
        if c == "<":
            depth += 1
        elif c == ">":
            depth -= 1
        elif depth <= 0 and c in "{(;":
            return i, c
        i += 1
    return -1, ""


class Decl:
    def __init__(self, path, name, kind, attrs, attrs_off, fields, body, offset):
        self.path = path
        self.name = name
        self.kind = kind
        self.attrs = attrs
        self.attrs_off = attrs_off
        self.fields = fields  # list of (visibility, name, type)
        self.body = body
        self.offset = offset


def parse_decls(path: str, masked: str):
    decls = []
    for m in DECL_RE.finditer(masked):
        idx, c = find_body_open(masked, m.end())
        if idx == -1:
            continue
        body = ""
        fields = []
        if c in "{(":
            close = matching_close(masked, idx)
            body = masked[idx + 1 : close]
            if m.group("kind") in ("struct", "union"):
                for k, part in enumerate(split_top_level(body)):
                    part = ATTR_RE.sub(" ", part)
                    fm = NAMED_FIELD_RE.match(part) if c == "{" else TUPLE_FIELD_RE.match(part)
                    if not fm:
                        continue
                    fname = fm.group("name") if c == "{" else str(k)
                    fields.append(((fm.group("vis") or "").strip(), fname, fm.group("ty").strip()))
        decls.append(Decl(path, m.group("name"), m.group("kind"), m.group("attrs") or "", m.start(), fields, body, m.start("kind")))
    return decls


def mentions(text: str, names) -> str:
    for name in sorted(names):
        if re.search(rf"\b{re.escape(name)}\b", text):
            return name
    return ""


class Model:
    """Private-key types, key-holding types and their key-bearing fields across all files."""

    def __init__(self, decls):
        self.decls = decls
        self.private = set(KNOWN_PRIVATE_TYPES)
        for d in decls:
            if PRIVATE_TYPE_NAME_RE.match(d.name):
                self.private.add(d.name)
        self.holders = set()
        changed = True
        while changed:
            changed = False
            for d in decls:
                if d.name in self.private or d.name in self.holders:
                    continue
                others = (self.private | self.holders) - {d.name}
                holds = d.kind == "enum" and bool(mentions(d.body, others))
                for _, fname, fty in d.fields:
                    if mentions(fty, others) or (BYTE_CONTAINER_RE.search(fty) and SECRET_FIELD_NAME_RE.match(fname)):
                        holds = True
                if holds:
                    self.holders.add(d.name)
                    changed = True
        self.key_fields = {}
        keyed = self.private | self.holders
        for d in decls:
            if d.name not in keyed:
                continue
            names = set()
            for _, fname, fty in d.fields:
                if mentions(fty, keyed - {d.name}):
                    names.add(fname)
                elif BYTE_CONTAINER_RE.search(fty) and (d.name in self.private or SECRET_FIELD_NAME_RE.match(fname)):
                    names.add(fname)
            self.key_fields.setdefault(d.name, set()).update(names)
        self.all_key_field_names = {f for fs in self.key_fields.values() for f in fs if not f.isdigit()}

    def keyed(self):
        return self.private | self.holders


# --------------------------------------------------------------------------- key-bytes checks


def check_decls(model: Model, path: str, masked: str, findings):
    for d in model.decls:
        if d.path != path:
            continue
        if d.name in model.private:
            what = "private-key type"
        elif d.name in model.holders:
            what = "key-holding type"
        elif d.name in ALWAYS_REDACTED_TYPES:
            what = "redacted type"
        else:
            what = ""
        if what:
            for am in ATTR_RE.finditer(d.attrs):
                attr = am.group(0)
                via = " (via cfg_attr)" if re.match(r"#\s*\[\s*cfg_attr\b", attr) else ""
                for dm in DERIVE_RE.finditer(attr):
                    for raw in dm.group(1).split(","):
                        leaf = raw.strip().split("::")[-1].strip()
                        if leaf in FORBIDDEN_DERIVES:
                            ln = line_of(masked, d.attrs_off + am.start())
                            findings.append(f"{path}:{ln}: forbidden derive({leaf}){via} on {what} {d.name}")
        # pub byte fields are forbidden on every type of the keystore crates.
        for vis, fname, fty in d.fields:
            if vis != "pub":
                continue
            ln = line_of(masked, d.offset)
            if BYTE_CONTAINER_RE.search(fty):
                findings.append(f"{path}:{ln}: pub byte field `{fname}` in {d.name} exposes key bytes")
            else:
                pty = mentions(fty, model.private)
                if pty:
                    findings.append(f"{path}:{ln}: pub field `{fname}` in {d.name} exposes private-key type {pty}")


IMPL_TRAIT_RE = re.compile(
    r"\bimpl\b(?:\s*<[^>{]*>)?\s+(?P<trait>[A-Za-z0-9_:]+)(?:\s*<[^>{]*>)?\s+for\s+(?P<ty>[A-Za-z_]\w*)(?:\s*<[^>{]*>)?[^{;]*\{"
)
IMPL_INHERENT_RE = re.compile(r"\bimpl\b(?:\s*<[^>{]*>)?\s+(?P<ty>[A-Za-z_]\w*)\s*(?:<[^>{]*>)?\s*(?:where[^{]*)?\{")


def check_impls(model: Model, path: str, stripped: str, masked: str, findings):
    keyed = model.keyed()
    for m in IMPL_TRAIT_RE.finditer(masked):
        trait_leaf = m.group("trait").split("::")[-1]
        ty = m.group("ty")
        if ty not in keyed and ty not in ALWAYS_REDACTED_TYPES:
            continue
        open_idx = m.end() - 1
        close_idx = matching_close(masked, open_idx)
        body_m = masked[open_idx : close_idx + 1]
        body_s = stripped[open_idx : close_idx + 1]
        ln = line_of(masked, m.start())
        if trait_leaf == "Serialize":
            findings.append(f"{path}:{ln}: forbidden impl Serialize for private-key type {ty}")
        elif trait_leaf == "Display":
            findings.append(f"{path}:{ln}: forbidden impl Display for private-key type {ty}")
        elif trait_leaf == "Debug":
            fields = model.key_fields.get(ty, set())
            touches = SECRET_FIELD_ACCESS_RE.search(body_m)
            if not touches and fields:
                alt = "|".join(re.escape(f) for f in sorted(fields))
                touches = re.search(rf"\bself\s*\.\s*(?:{alt})\b", body_m)
            if touches or not REDACTION_RE.search(body_s):
                findings.append(
                    f"{path}:{ln}: content-bearing Debug impl on private-key type {ty} "
                    "(must redact and must not reference key/byte fields)"
                )


def parse_fn_ret(masked: str, start: int):
    """From just after `fn name`, returns the return-type text ('' if none, None if unparsable)."""
    idx, c = find_body_open(masked, start)
    if idx == -1 or c != "(":
        return None
    close = matching_close(masked, idx)
    rm = re.match(r"\s*->\s*", masked[close + 1 :])
    if not rm:
        return ""
    j = close + 1 + rm.end()
    depth = 0
    k = j
    while k < len(masked):
        ch = masked[k]
        if ch == "-" and k + 1 < len(masked) and masked[k + 1] == ">":
            k += 2
            continue
        if ch in "<([":
            depth += 1
        elif ch in ">)]":
            depth -= 1
        elif depth <= 0 and (ch in "{;" or re.match(r"\bwhere\b", masked[k : k + 6])):
            break
        k += 1
    return masked[j:k]


PUB_FN_RE = re.compile(r"\bpub\s+(?:const\s+)?(?:async\s+)?(?:unsafe\s+)?(?:extern\s+\"[^\"]*\"\s+)?fn\s+(?P<fn>[A-Za-z_]\w*)")
PUB_TRAIT_RE = re.compile(r"\bpub\s+(?:unsafe\s+)?trait\s+(?P<name>[A-Za-z_]\w*)[^{;]*\{")
FN_RE = re.compile(r"\bfn\s+(?P<fn>[A-Za-z_]\w*)")


def check_returns(model: Model, path: str, masked: str, findings):
    keyed = model.keyed()
    impl_spans = []
    for m in IMPL_INHERENT_RE.finditer(masked):
        if m.group("ty") in keyed:
            impl_spans.append((m.end() - 1, matching_close(masked, m.end() - 1), m.group("ty")))

    def judge(fn_name, ret, offset, owner):
        if not ret:
            return
        ln = line_of(masked, offset)
        pty = mentions(ret, model.private)
        if pty:
            findings.append(f"{path}:{ln}: pub fn `{fn_name}` returns private-key type {pty}")
        elif RAW_ARRAY_RE.search(ret):
            findings.append(f"{path}:{ln}: pub fn `{fn_name}` returns a raw key array")
        elif owner and BYTE_CONTAINER_RE.search(ret):
            findings.append(f"{path}:{ln}: pub fn `{fn_name}` on key type {owner} returns key bytes")

    for m in PUB_FN_RE.finditer(masked):
        owner = next((ty for s, e, ty in impl_spans if s < m.start() < e), "")
        judge(m.group("fn"), parse_fn_ret(masked, m.end()), m.start(), owner)
    for tm in PUB_TRAIT_RE.finditer(masked):
        open_idx = tm.end() - 1
        close_idx = matching_close(masked, open_idx)
        for fm in FN_RE.finditer(masked, open_idx, close_idx):
            judge(f"{tm.group('name')}::{fm.group('fn')}", parse_fn_ret(masked, fm.end()), fm.start(), "")


LET_RE = re.compile(r"\blet\s+(?:mut\s+)?(?P<var>[A-Za-z_]\w*)\s*(?::[^=;]*)?=(?![=>])(?P<rhs>[^;]*);")


def secret_in(region: str, model: Model, tracked: dict) -> str:
    """Describes the first private-key value found in `region` (masked code), or ''."""
    m = SECRET_IDENT_RE.search(region)
    if m:
        return f"`{m.group(0)}`"
    m = SECRET_FIELD_RE.search(region)
    if m:
        return f"`{m.group(0).strip()}`"
    if model.all_key_field_names:
        alt = "|".join(re.escape(f) for f in sorted(model.all_key_field_names))
        m = re.search(rf"\.\s*(?:{alt})\b(?!\s*\(){PUBLIC_ACCESS}", region)
        if m:
            return f"key field `{m.group(0).strip()}`"
    for var, why in sorted(tracked.items()):
        if re.search(rf"(?<![.\w]){re.escape(var)}\b(?!\s*:[^:]){PUBLIC_ACCESS}", region):
            return f"private-key-typed value `{var}` ({why})"
    pty = mentions(region, model.private)
    if pty:
        return f"private-key type {pty}"
    return ""


def tracked_vars(model: Model, masked: str) -> dict:
    tracked = {}
    alt = "|".join(re.escape(t) for t in sorted(model.private))
    typed = re.compile(
        rf"\b(?P<var>[a-z_]\w*)\s*:\s*(?:&\s*(?:'\w+\s+)?(?:mut\s+)?|[A-Za-z0-9_:]+\s*<\s*)*(?:[A-Za-z0-9_]+::)*(?P<ty>{alt})\b"
    )
    for m in typed.finditer(masked):
        tracked[m.group("var")] = m.group("ty")
    ctor = re.compile(rf"\blet\s+(?:mut\s+)?(?P<var>[a-z_]\w*)\s*=\s*(?:[A-Za-z0-9_]+::)*(?P<ty>{alt})\b")
    for m in ctor.finditer(masked):
        tracked[m.group("var")] = m.group("ty")
    lets = [(m.group("var"), m.group("rhs")) for m in LET_RE.finditer(masked)]
    for _ in range(16):
        grew = False
        for var, rhs in lets:
            if var == "_" or var in tracked:
                continue
            why = secret_in(rhs, model, tracked)
            if why:
                tracked[var] = f"copied from {why}"
                grew = True
        if not grew:
            break
    return tracked


def check_sinks(model: Model, path: str, masked: str, findings):
    tracked = tracked_vars(model, masked)
    seen = set()
    for kind, sink_re in SINKS:
        for m in sink_re.finditer(masked):
            if re.search(r"\bfn\s+$", masked[max(0, m.start() - 12) : m.start()]):
                continue
            j = m.end()
            while j < len(masked) and masked[j] in " \t\r\n":
                j += 1
            if j < len(masked) and masked[j] in "([{":
                region = masked[j : matching_close(masked, j) + 1]
            else:
                end = masked.find(";", m.start())
                region = masked[m.start() : (len(masked) if end == -1 else end)]
            why = secret_in(region, model, tracked)
            if not why:
                continue
            ln = line_of(masked, m.start())
            if (ln, kind) in seen:
                continue
            seen.add((ln, kind))
            findings.append(f"{path}:{ln}: private-key value {why} passed to {kind}")


def check_exports(path: str, masked: str, findings):
    for api_name, api_re in EXPORT_API_DENYLIST:
        for m in api_re.finditer(masked):
            findings.append(f"{path}:{line_of(masked, m.start())}: forbidden private-key export API `{api_name}`")


def scan_key_bytes(paths):
    loaded = {p: load(p) for p in paths}
    decls = []
    for p in paths:
        decls.extend(parse_decls(p, loaded[p][1]))
    model = Model(decls)
    findings = []
    for p in paths:
        stripped, masked = loaded[p]
        check_decls(model, p, masked, findings)
        check_impls(model, p, stripped, masked, findings)
        check_returns(model, p, masked, findings)
        check_exports(p, masked, findings)
        check_sinks(model, p, masked, findings)
    return findings


# --------------------------------------------------------------------------- UvRelease::issue rule

UV_ISSUE_RES = [
    ("UvRelease::issue called", re.compile(r"\bUvRelease\s*>?\s*::\s*issue\b")),
    ("UvRelease renamed with `as`", re.compile(r"\bUvRelease\s+as\s+[A-Za-z_]\w*")),
    ("type alias of UvRelease", re.compile(r"\btype\s+[A-Za-z_]\w*\s*(?:<[^>]*>)?\s*=\s*(?:[A-Za-z0-9_]+::)*UvRelease\b")),
]
SKIP_DIRS = {"target", "node_modules"}


def uv_allowed(rel: str) -> str:
    """'all' if every use is allowed, 'tests' if only #[cfg(test)] items may use it, '' if none."""
    if rel.startswith("crates/fid-uv/") or rel.startswith("crates/fid-keystore/tests/"):
        return "all"
    if rel.startswith("crates/fid-keystore/src/"):
        return "tests"
    return ""


def scan_uv_issue(workspace: str):
    findings = []
    scanned = 0
    for dirpath, dirnames, filenames in os.walk(workspace):
        dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS and not d.startswith("."))
        for fname in sorted(filenames):
            if not fname.endswith(".rs"):
                continue
            full = os.path.join(dirpath, fname)
            rel = os.path.relpath(full, workspace).replace(os.sep, "/")
            scanned += 1
            allowed = uv_allowed(rel)
            if allowed == "all":
                continue
            try:
                with open(full, "r", encoding="utf-8") as f:
                    raw = f.read()
            except (OSError, UnicodeDecodeError):
                continue
            if "UvRelease" not in raw:
                continue
            _, masked = lex(raw)
            if allowed == "tests":
                masked = blank_spans(masked, test_spans(masked))
            for what, rx in UV_ISSUE_RES:
                for m in rx.finditer(masked):
                    findings.append(
                        f"{rel}:{line_of(masked, m.start())}: {what} outside fid-uv "
                        "(only TRUST.SIGN.UV may issue UV releases; see PR #444)"
                    )
    return findings, scanned


# --------------------------------------------------------------------------- CLI


def collect_targets(roots):
    files = []
    for root in roots:
        if os.path.isfile(root):
            if root.endswith(".rs"):
                files.append(root)
            continue
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames.sort()
            for fname in sorted(filenames):
                if fname.endswith(".rs"):
                    files.append(os.path.join(dirpath, fname))
    return files


def repo_root() -> str:
    return os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))


def default_roots():
    crates_dir = os.path.join(repo_root(), "crates")
    roots = []
    if os.path.isdir(crates_dir):
        for entry in sorted(os.listdir(crates_dir)):
            if entry == "fid-keystore" or entry.startswith("fid-keystore-"):
                src = os.path.join(crates_dir, entry, "src")
                if os.path.isdir(src):
                    roots.append(src)
    return roots


USAGE = "usage: key-bytes-scan [--root <path>]... | key-bytes-scan --uv-release-issue [--workspace <repo>]"


def main(argv) -> int:
    roots = []
    uv_mode = False
    workspace = None
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("--root", "--workspace"):
            if i + 1 >= len(argv):
                print(USAGE, file=sys.stderr)
                return 2
            if arg == "--root":
                roots.append(argv[i + 1])
            else:
                workspace = argv[i + 1]
            i += 2
        elif arg == "--uv-release-issue":
            uv_mode = True
            i += 1
        else:
            print(f"unknown argument: {arg}\n{USAGE}", file=sys.stderr)
            return 2
    if uv_mode:
        if roots:
            print(USAGE, file=sys.stderr)
            return 2
        findings, scanned = scan_uv_issue(workspace or repo_root())
        if scanned == 0:
            print("key-bytes-scan --uv-release-issue: no Rust source files found", file=sys.stderr)
            return 2
        if findings:
            for finding in findings:
                print(finding, file=sys.stderr)
            print(f"key-bytes-scan --uv-release-issue: {len(findings)} violation(s)", file=sys.stderr)
            return 1
        print(f"key-bytes-scan --uv-release-issue: ok ({scanned} file(s) scanned, 0 violations)")
        return 0
    if workspace is not None:
        print(USAGE, file=sys.stderr)
        return 2
    if not roots:
        roots = default_roots()
    targets = collect_targets(roots)
    if not targets:
        print("key-bytes-scan: no Rust source files found to scan", file=sys.stderr)
        return 2
    all_findings = scan_key_bytes(targets)
    if all_findings:
        for finding in all_findings:
            print(finding, file=sys.stderr)
        print(f"key-bytes-scan: {len(all_findings)} violation(s) in {len(targets)} file(s)", file=sys.stderr)
        return 1
    print(f"key-bytes-scan: ok ({len(targets)} file(s) scanned, 0 violations)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
