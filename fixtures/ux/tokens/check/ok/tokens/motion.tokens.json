{
  "motion": {
    "$description": "Motion tokens (UX.TOKENS.SPACE). Each token is a group of duration, easing (cubic Bezier) and reduced-duration, which is 0ms for users who ask for reduced motion. Panel transitions take at most 250ms.",
    "feedback": {
      "press": {
        "duration": {
          "$type": "duration",
          "$value": "100ms"
        },
        "easing": {
          "$type": "cubicBezier",
          "$value": [0.2, 0, 0, 1]
        },
        "reduced-duration": {
          "$type": "duration",
          "$value": "0ms"
        }
      },
      "toast": {
        "duration": {
          "$type": "duration",
          "$value": "200ms"
        },
        "easing": {
          "$type": "cubicBezier",
          "$value": [0, 0, 0.2, 1]
        },
        "reduced-duration": {
          "$type": "duration",
          "$value": "0ms"
        }
      }
    },
    "panel": {
      "close": {
        "duration": {
          "$type": "duration",
          "$value": "150ms"
        },
        "easing": {
          "$type": "cubicBezier",
          "$value": [0.4, 0, 1, 1]
        },
        "reduced-duration": {
          "$type": "duration",
          "$value": "0ms"
        }
      },
      "open": {
        "duration": {
          "$type": "duration",
          "$value": "200ms"
        },
        "easing": {
          "$type": "cubicBezier",
          "$value": [0, 0, 0.2, 1]
        },
        "reduced-duration": {
          "$type": "duration",
          "$value": "0ms"
        }
      }
    }
  }
}
