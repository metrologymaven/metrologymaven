{
  "elev": {
    "$type": "shadow",
    "0": {
      "$extensions": {
        "org.metrologymaven.elevation": {
          "surface": "sem.surface.base"
        }
      },
      "$value": {
        "blur": "0px",
        "color": "#00000029",
        "offsetX": "0px",
        "offsetY": "1px",
        "spread": "0px"
      }
    },
    "1": {
      "$extensions": {
        "org.metrologymaven.elevation": {
          "surface": "sem.surface.raised"
        }
      },
      "$value": {
        "blur": "2px",
        "color": "#00000029",
        "offsetX": "0px",
        "offsetY": "1px",
        "spread": "0px"
      }
    },
    "2": {
      "$extensions": {
        "org.metrologymaven.elevation": {
          "border": "sem.border.strong",
          "surface": "sem.surface.raised"
        }
      },
      "$value": {
        "blur": "8px",
        "color": "#00000029",
        "offsetX": "0px",
        "offsetY": "1px",
        "spread": "0px"
      }
    },
    "3": {
      "$extensions": {
        "org.metrologymaven.elevation": {
          "surface": "sem.surface.sunken"
        }
      },
      "$value": {
        "blur": "2px",
        "color": "#00000029",
        "offsetX": "0px",
        "offsetY": "1px",
        "spread": "0px"
      }
    },
    "4": {
      "$extensions": {
        "org.metrologymaven.elevation": {
          "border": "sem.border.subtle",
          "surface": "sem.surface.sunken"
        }
      },
      "$value": {
        "blur": "2px",
        "color": "#00000029",
        "offsetX": "0px",
        "offsetY": "1px",
        "spread": "0px"
      }
    },
    "5": {
      "$extensions": {
        "org.metrologymaven.elevation": {
          "border": "sem.border.subtle",
          "surface": "sem.surface.base"
        }
      },
      "$value": {
        "blur": "2px",
        "color": "#00000029",
        "offsetX": "0px",
        "offsetY": "1px",
        "spread": "0px"
      }
    }
  }
}
