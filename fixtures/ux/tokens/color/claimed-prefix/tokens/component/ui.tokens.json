{
  "comp": {
    "$type": "color",
    "badge": {
      "claimed-bg": {
        "$value": "{sem.text.value.measured}"
      }
    },
    "button": {
      "bg": {
        "primary": {
          "$value": "{sem.brand.accent}"
        }
      }
    },
    "input": {
      "fg": {
        "placeholder": {
          "$value": "{sem.text.muted}"
        }
      }
    },
    "value": {
      "fg": {
        "claimed": {
          "$value": "{sem.text.value.claimed}"
        },
        "measured": {
          "$value": "{sem.text.value.measured}"
        }
      }
    }
  }
}
