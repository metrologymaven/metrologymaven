<?xml version="1.0" encoding="UTF-8"?>
<!-- Values holds an XSD list of doubles (a ListDoubleType-like value) with runs of
     spaces, tabs and newlines; list_ws_single.qif has the same list with single spaces. -->
<QIFDocument xmlns="http://qifstandards.org/xsd/qif3">
  <PointList>
    <Count>  3 </Count>
    <Values>
      0.0    1.25	-2.500
      3.0e-3     4
      5.000
    </Values>
  </PointList>
</QIFDocument>
