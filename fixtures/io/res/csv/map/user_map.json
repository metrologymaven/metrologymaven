{
  "schema": "colmap@1",
  "id": "acme.cmm.semicolon",
  "version": "1.2.0",
  "layout": "long",
  "dialect": {
    "delimiter": "semicolon",
    "decimal_mark": ",",
    "header": true,
    "quote": "rfc4180",
    "encoding": "utf-8",
    "line_ending": "crlf"
  },
  "columns": [
    { "field": "characteristic_id", "header": "Merkmal-Nr.", "required": true },
    { "field": "characteristic_name", "header": "Bezeichnung", "required": false },
    { "field": "nominal", "header": "Sollmaß", "required": false },
    { "field": "actual", "header": "Istmaß", "required": true },
    { "field": "lower_limit", "header": "UT", "required": false },
    { "field": "upper_limit", "header": "OT", "required": false },
    { "field": "unit", "index": 6, "required": true },
    { "field": "status", "header": "Status", "required": false }
  ]
}
