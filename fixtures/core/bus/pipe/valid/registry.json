  {
   "id": "t.combo",
   "major": 1,
   "title": "Test command",
   "description": "Synthetic command of the CORE.BUS.PIPE.VALID test registry.",
   "params_schema": {
    "$defs": {
     "pos": {
      "type": "integer",
      "minimum": 0
     },
     "label": {
      "type": "string",
      "pattern": "^L[0-9]+$"
     }
    },
    "type": "object",
    "properties": {
     "kind": {
      "enum": [
       "a",
       "b"
      ]
     },
     "a_val": {
      "$ref": "#/$defs/pos"
     },
     "pair": {
      "type": "array",
      "prefixItems": [
       {
        "$ref": "#/$defs/label"
       },
       {
        "type": "integer"
       }
      ],
      "items": false
     },
     "list": {
      "type": "array",
      "contains": {
       "const": "x"
      },
      "minContains": 1,
      "maxContains": 2,
      "unevaluatedItems": {
       "type": "string"
      }
     },
     "pick": {
      "oneOf": [
       {
        "type": "integer",
        "multipleOf": 2
       },
       {
        "type": "integer",
        "multipleOf": 3
       }
      ]
     },
     "any": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "integer",
        "minimum": 100
       }
      ]
     },
     "nope": {
      "not": {
       "type": "string"
      }
     },
     "both": {
      "allOf": [
       {
        "type": "integer"
       },
       {
        "maximum": 5
       }
      ]
     }
    },
    "patternProperties": {
     "^x_[a-z]+$": {
      "type": "integer"
     }
    },
    "propertyNames": {
     "maxLength": 12
    },
    "dependentRequired": {
     "kind": [
      "a_val"
     ]
    },
    "dependentSchemas": {
     "pair": {
      "required": [
       "kind"
      ]
     }
    },
    "if": {
     "properties": {
      "kind": {
       "const": "b"
      }
     },
     "required": [
      "kind"
     ]
    },
    "then": {
     "required": [
      "any"
     ]
    },
    "else": {
     "properties": {
      "any": {
       "type": "string"
      }
     }
    },
    "unevaluatedProperties": false
   },
   "result_schema": {
    "type": "object"
   },
   "side_effect": "W2",
   "mcp_projection": "exposed",
   "determinism": "D0",
   "idempotency": "none",
   "fs_effect": "none",
   "undo": "head_move",
   "preconditions": [],
