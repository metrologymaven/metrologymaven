  {
   "id": "t.shapes",
   "major": 1,
   "title": "Test command",
   "description": "Synthetic command of the CORE.BUS.PIPE.VALID test registry.",
   "params_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
     "count",
     "name"
    ],
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8,
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
     },
     "step": {
      "type": "number",
      "x-quantity": "length",
      "exclusiveMinimum": 0,
      "multipleOf": 0.25
     },
     "mode": {
      "enum": [
       "fast",
       "slow",
       null
      ]
     },
     "version": {
      "const": 2
     },
     "tags": {
      "type": "array",
      "items": {
       "type": "string",
       "maxLength": 4
      },
      "maxItems": 3,
      "uniqueItems": true
     },
     "when": {
      "type": "string",
      "format": "date-time"
     },
     "day": {
      "type": "string",
      "format": "date"
     },
     "uid": {
      "type": "string",
      "format": "uuid"
     },
     "host": {
      "type": "string",
      "format": "hostname"
     },
     "ip4": {
      "type": "string",
      "format": "ipv4"
     },
     "ip6": {
      "type": "string",
      "format": "ipv6"
     },
     "span": {
      "type": "string",
      "format": "duration"
     },
     "flag": {
      "type": "boolean"
     },
     "note": {
      "type": [
       "string",
       "null"
      ],
      "x-untrusted": true
     }
    }
   },
   "result_schema": {
    "type": "object"
   },
   "side_effect": "W2",
   "mcp_projection": "exposed",
   "determinism": "D0",
   "idempotency": "none",
   "fs_effect": "none",
   "undo": "head_move",
   "preconditions": [],
   "effects": [
    "TestDone"
   ],
   "algorithms": [],
   "exposure": [
    "cli",
