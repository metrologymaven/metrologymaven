{
  "license": "CC-BY-4.0",
  "node": "CORE.BUS.PRIN",
  "note": "Hand-labelled identifier cases. Rules: 1 to 256 bytes; then, per character and in this order, no general category Cc (control_char), Zl or Zp (separator), Co (private_use), Cf (format_char), no other Default_Ignorable_Code_Point (default_ignorable), no Cn (unassigned, noncharacters included), no blank other than U+0020: Zs except U+0020, and U+2800 (blank_char); all Unicode 16.0; then NFC (not_nfc). Every character outside printable ASCII is written as a \\uXXXX escape (surrogate pairs above U+FFFF), so the bytes are unambiguous.",
  "cases": [
    { "name": "plain", "text": "alice", "expect": "ok" },
    { "name": "prefixed", "text": "server-user:carol", "expect": "ok" },
    { "name": "space_is_zs", "text": "a b", "expect": "ok" },
    { "name": "nfc_e_acute", "text": "\u00E9mile", "expect": "ok" },
    { "name": "greek", "text": "\u03A9mega", "expect": "ok" },
    { "name": "hangul_syllable", "text": "\uAC00\uB098", "expect": "ok" },
    { "name": "empty", "text": "", "expect": "empty" },
    { "name": "nul", "text": "ali\u0000ce", "expect": "control_char" },
    { "name": "newline", "text": "alice\u000A", "expect": "control_char" },
    { "name": "nel_c1", "text": "a\u0085b", "expect": "control_char" },
    { "name": "delete", "text": "bob\u007F", "expect": "control_char" },
    { "name": "rlo_bidi_override", "text": "alice\u202E", "expect": "format_char" },
    { "name": "lri_bidi_isolate", "text": "\u2066x", "expect": "format_char" },
    { "name": "zero_width_space", "text": "a\u200Bb", "expect": "format_char" },
    { "name": "zero_width_joiner", "text": "a\u200Db", "expect": "format_char" },
    { "name": "bom", "text": "\uFEFFalice", "expect": "format_char" },
    { "name": "soft_hyphen", "text": "a\u00ADb", "expect": "format_char" },
    { "name": "word_joiner", "text": "a\u2060b", "expect": "format_char" },
    { "name": "tag_language", "text": "x\uDB40\uDC01", "expect": "format_char" },
    { "name": "tag_space", "text": "x\uDB40\uDC20", "expect": "format_char" },
    { "name": "line_separator", "text": "a\u2028b", "expect": "separator" },
    { "name": "paragraph_separator", "text": "a\u2029b", "expect": "separator" },
    { "name": "private_use_bmp_first", "text": "\uE000a", "expect": "private_use" },
    { "name": "private_use_bmp_last", "text": "\uF8FF", "expect": "private_use" },
    { "name": "private_use_plane_15", "text": "a\uDB80\uDC00", "expect": "private_use" },
    { "name": "private_use_plane_16", "text": "a\uDBC0\uDC00", "expect": "private_use" },
    { "name": "combining_grapheme_joiner", "text": "a\u034Fb", "expect": "default_ignorable" },
    { "name": "hangul_filler", "text": "\u3164alice", "expect": "default_ignorable" },
    { "name": "hangul_choseong_filler", "text": "a\u115Fb", "expect": "default_ignorable" },
    { "name": "halfwidth_hangul_filler", "text": "a\uFFA0b", "expect": "default_ignorable" },
    { "name": "variation_selector_16", "text": "a\uFE0F", "expect": "default_ignorable" },
    { "name": "variation_selector_17", "text": "a\uDB40\uDD00", "expect": "default_ignorable" },
    { "name": "reserved_ignorable_fff0", "text": "a\uFFF0b", "expect": "default_ignorable" },
    { "name": "unassigned_0378", "text": "a\u0378b", "expect": "unassigned" },
    { "name": "unassigned_plane_3_end", "text": "a\uD8BF\uDFFD", "expect": "unassigned" },
    { "name": "noncharacter_ffff", "text": "a\uFFFFb", "expect": "unassigned" },
    { "name": "noncharacter_fdd0", "text": "a\uFDD0b", "expect": "unassigned" },
    { "name": "no_break_space", "text": "a\u00A0b", "expect": "blank_char" },
    { "name": "ideographic_space", "text": "a\u3000b", "expect": "blank_char" },
    { "name": "ogham_space_mark", "text": "a\u1680b", "expect": "blank_char" },
    { "name": "braille_pattern_blank", "text": "a\u2800b", "expect": "blank_char" },
    { "name": "nfd_e_acute", "text": "e\u0301mile", "expect": "not_nfc" },
    { "name": "a_combining_ring", "text": "A\u030A", "expect": "not_nfc" },
    { "name": "angstrom_sign", "text": "\u212B", "expect": "not_nfc" }
  ]
}
