{
  "format": "fid-settings-manifest/1",
  "settings": [
    {
      "key": "probe.approach_distance",
      "owner": "probe",
      "schema": {"type": "number", "x-quantity": "length", "x-unit": "mm", "minimum": 0, "maximum": 100},
      "default": 2,
      "scopes": ["project", "user"],
      "admin": false
    },
    {
      "key": "ui.show_tips",
      "owner": "ui",
      "schema": {"type": "boolean"},
      "default": true,
      "scopes": ["user"],
      "admin": false
    },
    {
      "key": "net.allowed_roots",
      "owner": "net",
      "schema": {
        "type": "array",
        "items": {"type": "string", "minLength": 1, "maxLength": 1024},
        "maxItems": 64,
        "uniqueItems": true
      },
      "default": [],
      "scopes": ["machine"],
      "admin": true
    }
  ]
}
