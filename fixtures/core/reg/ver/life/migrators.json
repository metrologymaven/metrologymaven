{
 "cases": [
  {
   "name": "valid 1 -> 2",
   "migrators": [
    {
     "algorithm": "demo.cmd.migrate@1.0.0",
     "command": "demo.cmd",
     "from_major": 1,
     "to_major": 2
    }
   ],
   "expect": "ok"
  },
  {
   "name": "target below source (3 -> 2)",
   "migrators": [
    {
     "algorithm": "demo.cmd.migrate@1.0.0",
     "command": "demo.cmd",
     "from_major": 3,
     "to_major": 2
    }
   ],
   "expect": "migrator_invalid"
  },
  {
   "name": "target equals source",
   "migrators": [
    {
     "algorithm": "demo.cmd.migrate@1.0.0",
     "command": "demo.cmd",
     "from_major": 2,
     "to_major": 2
    }
   ],
   "expect": "migrator_invalid"
  },
  {
   "name": "source removed",
   "migrators": [
    {
     "algorithm": "demo.cmd.migrate@1.0.0",
     "command": "demo.old",
     "from_major": 1,
     "to_major": 2
    }
   ],
   "expect": "migrator_invalid"
  },
  {
   "name": "source not declared",
   "migrators": [
    {
     "algorithm": "demo.cmd.migrate@1.0.0",
     "command": "demo.none",
     "from_major": 1,
     "to_major": 2
    }
   ],
   "expect": "migrator_invalid"
  },
  {
   "name": "duplicate source and target",
   "migrators": [
    {
     "algorithm": "demo.cmd.migrate@1.0.0",
     "command": "demo.cmd",
     "from_major": 1,
     "to_major": 2
    },
    {
     "algorithm": "demo.cmd.migrate@1.1.0",
     "command": "demo.cmd",
     "from_major": 1,
     "to_major": 2
    }
   ],
   "expect": "migrator_invalid"
  }
 ]
}
