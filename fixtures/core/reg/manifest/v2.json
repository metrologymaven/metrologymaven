{
 "format": 1,
 "quantity_catalogue_digest": "sha256:12c5f2875a2916cbbe169ee6c788429230619d39615c9fd4af385211822fd44e",
 "commands": [
  {
   "id": "demo.export",
   "major": 1,
   "title": "Demo demo.export",
   "description": "Measures one feature against a tolerance.",
   "params_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "feature",
     "tol"
    ],
    "properties": {
     "feature": {
      "type": "string",
      "x-ref": "feature",
      "description": "Feature to measure."
     },
     "tol": {
      "type": "number",
      "x-quantity": "length",
      "x-unit": "mm",
      "minimum": 0,
      "maximum": 10
     },
     "mode": {
      "type": "string",
      "enum": [
       "fast",
       "precise"
      ],
      "default": "fast"
     },
     "samples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 25,
      "x-ui": {
       "widget": "slider"
      }
     },
     "points": {
      "type": "array",
      "maxItems": 100,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "x"
       ],
       "properties": {
        "x": {
         "type": "number",
         "x-quantity": "length",
         "x-unit": "mm"
        }
       }
      }
     },
     "label": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z]+$"
     }
    }
   },
   "result_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "deviation",
     "status"
    ],
    "properties": {
     "deviation": {
      "type": "number",
      "x-quantity": "length",
      "x-unit": "mm"
     },
     "status": {
      "type": "string",
      "enum": [
       "ok",
       "fail"
      ]
     },
     "note": {
      "type": "string"
     }
    }
   },
   "side_effect": "R0",
   "mcp_projection": "exposed",
   "determinism": "D0",
   "idempotency": "natural",
   "fs_effect": "none",
   "undo": "head_move",
   "preconditions": [
    {
     "expr": "params.tol >= 0.0",
     "bound": 100,
     "message_key": "demo.tol_negative"
    }
   ],
   "effects": [],
   "algorithms": [
    "geo.fit.lsq@1.0.0"
   ],
   "exposure": [
    "cli",
    "mcp"
   ],
   "lifecycle": {
    "state": "active",
    "since": "2026-01-01"
   },
   "human_only": false,
   "network": "none",
   "web": "partial",
   "web_note": "No probe access in the browser.",
   "cli_bare": false,
   "definition_digest": "sha256:3ed7bdb3b9a3d84dd862f5057b73f6b2e9fee54fd24ac31a30a352c0caf8d992"
  },
