{
  "about": "AUTO.SURF.INPROC AC-2: scripted ApiReply cases and the final envelope each must produce, hand-labelled from the bus-code to envelope-code table and the bus_origin rule of spec node AUTO.SURF.INPROC, and from the D-035 rule (maintainer decision 2026-11-25) that hidden_command finishes byte for byte as the bus's not_found/unknown_major refusal from stage resolve (not generated by the Rust code). The test compares RFC 8785 bytes. Project-authored, CC-BY-4.0.",
  "command": "demo.show_thing@1",
  "cases": [
    {
      "name": "committed_with_result",
      "reply": {"kind": "committed", "entry": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef", "result": {"n": 1}},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "journal_entry_hash": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef", "outcome": "committed", "result": {"n": 1}}
    },
    {
      "name": "committed_without_result",
      "reply": {"kind": "committed", "entry": "sha256:fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "journal_entry_hash": "sha256:fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210", "outcome": "committed"}
    },
    {
      "name": "computed_with_result",
      "reply": {"kind": "computed", "result": {"b": [true, null], "a": "x"}},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "outcome": "computed", "result": {"a": "x", "b": [true, null]}}
    },
    {
      "name": "computed_without_result",
      "reply": {"kind": "computed"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "outcome": "computed"}
    },
    {
      "name": "request_filed",
      "reply": {"kind": "request_filed", "request_id": "01900000-0000-7000-8000-000000000001"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "outcome": "request_filed", "request_id": "01900000-0000-7000-8000-000000000001"}
    },
    {
      "name": "request_filed_without_id",
      "reply": {"kind": "request_filed", "request_id": ""},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "error": {"code": "internal_error", "message": "the bus filed a request with no request ID"}, "outcome": "failed"}
    },
    {
      "name": "dry_run",
      "reply": {"kind": "dry_run", "result": {"events": [{"type": "ThingShown"}]}},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "outcome": "dry_run", "result": {"events": [{"type": "ThingShown"}]}}
    },
    {
      "name": "validation_unit_mismatch",
      "reply": {"kind": "failed", "code": "validation", "reason": "unit_mismatch", "detail": "/length: \"deg\" is not a length", "stage": "validate"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "error": {"code": "unit_error", "details": {"bus_code": "validation", "bus_origin": "pipeline", "bus_reason": "unit_mismatch"}, "message": "/length: \"deg\" is not a length"}, "outcome": "failed"}
    },
    {
      "name": "validation_other",
      "reply": {"kind": "failed", "code": "validation", "reason": "schema", "detail": "/n: expected an integer", "stage": "validate"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "error": {"code": "validation_error", "details": {"bus_code": "validation", "bus_origin": "pipeline", "bus_reason": "schema"}, "message": "/n: expected an integer"}, "outcome": "failed"}
    },
    {
      "name": "policy_raw_path_refused",
      "reply": {"kind": "failed", "code": "policy", "reason": "raw_path_refused", "detail": "/file: a raw path is refused", "stage": "authorise"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "error": {"code": "raw_path_refused", "details": {"bus_code": "policy", "bus_origin": "bus", "bus_reason": "raw_path_refused"}, "message": "/file: a raw path is refused"}, "outcome": "failed"}
    },
    {
      "name": "policy_outside_root",
      "reply": {"kind": "failed", "code": "policy", "reason": "outside_root", "detail": "root:data/../x leaves its root", "stage": "authorise"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "error": {"code": "root_escape", "details": {"bus_code": "policy", "bus_origin": "bus", "bus_reason": "outside_root"}, "message": "root:data/../x leaves its root"}, "outcome": "failed"}
    },
    {
      "name": "policy_bad_handle",
      "reply": {"kind": "failed", "code": "policy", "reason": "bad_handle", "detail": "not a root handle", "stage": "authorise"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "error": {"code": "validation_error", "details": {"bus_code": "policy", "bus_origin": "bus", "bus_reason": "bad_handle"}, "message": "not a root handle"}, "outcome": "failed"}
    },
    {
      "name": "policy_other",
      "reply": {"kind": "failed", "code": "policy", "reason": "human_only", "detail": "", "stage": "authorise"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "error": {"code": "policy_refused", "details": {"bus_code": "policy", "bus_origin": "bus", "bus_reason": "human_only"}, "message": ""}, "outcome": "failed"}
    },
    {
      "name": "precondition",
      "reply": {"kind": "failed", "code": "precondition", "reason": "false", "detail": "thing.exists is false", "stage": "precondition"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "error": {"code": "precondition_failed", "details": {"bus_code": "precondition", "bus_origin": "bus", "bus_reason": "false"}, "message": "thing.exists is false"}, "outcome": "failed"}
    },
    {
      "name": "conflict",
      "reply": {"kind": "failed", "code": "conflict", "reason": "head_moved", "detail": "tail moved", "stage": "commit"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "error": {"code": "conflict", "details": {"bus_code": "conflict", "bus_origin": "bus", "bus_reason": "head_moved"}, "message": "tail moved"}, "outcome": "failed"}
    },
    {
      "name": "idempotency_mismatch",
      "reply": {"kind": "failed", "code": "idempotency_mismatch", "reason": "args_digest_differs", "detail": "same key, other parameters", "stage": "route"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "error": {"code": "conflict", "details": {"bus_code": "idempotency_mismatch", "bus_origin": "bus", "bus_reason": "args_digest_differs"}, "message": "same key, other parameters"}, "outcome": "failed"}
    },
    {
      "name": "not_found",
      "reply": {"kind": "failed", "code": "not_found", "reason": "unknown_entity", "detail": "no entity e:7", "stage": "handler"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "error": {"code": "not_found", "details": {"bus_code": "not_found", "bus_origin": "handler", "bus_reason": "unknown_entity"}, "message": "no entity e:7"}, "outcome": "failed"}
    },
    {
      "name": "hidden_command",
      "reply": {"kind": "failed", "code": "hidden_command", "reason": "hidden_major", "detail": "demo.show_thing@1: hidden major; only replay may invoke it", "stage": "resolve"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "error": {"code": "not_found", "details": {"bus_code": "not_found", "bus_origin": "pipeline", "bus_reason": "unknown_major"}, "message": "\"demo.show_thing\"@1: unknown major"}, "outcome": "failed"}
    },
    {
      "name": "hidden_command_from_handler",
      "reply": {"kind": "failed", "code": "hidden_command", "reason": "hidden_major", "detail": "something else entirely", "stage": "handler"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "error": {"code": "not_found", "details": {"bus_code": "not_found", "bus_origin": "pipeline", "bus_reason": "unknown_major"}, "message": "\"demo.show_thing\"@1: unknown major"}, "outcome": "failed"}
    },
    {
      "name": "unauthenticated",
      "reply": {"kind": "failed", "code": "unauthenticated", "reason": "no_identity", "detail": "the channel has no identity", "stage": "session"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "error": {"code": "policy_refused", "details": {"bus_code": "unauthenticated", "bus_origin": "bus", "bus_reason": "no_identity"}, "message": "the channel has no identity"}, "outcome": "failed"}
    },
    {
      "name": "upgrade_refused",
      "reply": {"kind": "failed", "code": "upgrade_refused", "reason": "declined", "detail": "no_presence_provider", "stage": "session"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "error": {"code": "policy_refused", "details": {"bus_code": "upgrade_refused", "bus_origin": "bus", "bus_reason": "declined"}, "message": "no_presence_provider"}, "outcome": "failed"}
    },
    {
      "name": "undeclared_effect",
      "reply": {"kind": "failed", "code": "undeclared_effect", "reason": "undeclared_event_type", "detail": "ThingDeleted", "stage": "effects"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "error": {"code": "internal_error", "details": {"bus_code": "undeclared_effect", "bus_origin": "bus", "bus_reason": "undeclared_event_type"}, "message": "ThingDeleted"}, "outcome": "failed"}
    },
    {
      "name": "internal",
      "reply": {"kind": "failed", "code": "internal", "reason": "storage", "detail": "disk full é", "stage": "commit"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "error": {"code": "internal_error", "details": {"bus_code": "internal", "bus_origin": "bus", "bus_reason": "storage"}, "message": "disk full é"}, "outcome": "failed"}
    },
    {
      "name": "cancelled",
      "reply": {"kind": "failed", "code": "cancelled", "reason": "requested", "detail": "cancelled by the caller", "stage": "handler"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "outcome": "cancelled"}
    },
    {
      "name": "unknown_code",
      "reply": {"kind": "failed", "code": "future_code", "reason": "future_reason", "detail": "from a newer bus", "stage": "handler"},
      "expected": {"command_id": "demo.show_thing@1", "envelope_version": 1, "error": {"code": "internal_error", "details": {"bus_code": "future_code", "bus_origin": "handler", "bus_reason": "future_reason"}, "message": "from a newer bus"}, "outcome": "failed"}
    }
  ]
}
