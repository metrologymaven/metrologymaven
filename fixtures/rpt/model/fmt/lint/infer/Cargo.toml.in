# Manifest of the MIR-layer fixture crate, copied to a temporary directory as Cargo.toml by
# `tools/rpt_float_lint.py --mir-selftest` (kept as .in so the repository has no stray
# package). Standalone: its own empty workspace, one path dependency (`dep`).
[package]
name = "rpt-float-rule-infer-fixture"
version = "0.0.0"
edition = "2021"
publish = false

[lib]
path = "src/lib.rs"

[dependencies]
dep = { path = "dep" }

[workspace]
